{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@choseong-run/shared": ["../../packages/shared/src/index.ts"],
      "@choseong-run/prompts": ["../../packages/prompts/src/index.ts"],
      "@choseong-run/chosung": ["../../packages/chosung/src/index.ts"],
      "@choseong-run/words": ["../../packages/words/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
